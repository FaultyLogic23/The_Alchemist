<https://w3id.org/alchemist/ontology> rdf:type owl:Ontology ;
                                       <http://purl.org/dc/elements/1.1/creator> "A project created by Samuele Bertelli"@en ;
                                       rdfs:comment "The Alchemist LOD project aim to represent The Alchemist Novel written by Paulo Coelho beyond the book itself by stating how many other works inspired and what inspired the author to write it."@en ;
                                       rdfs:label "The Alchemist LOD project"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://id.loc.gov/vocabulary/relators/adp
marcrel:adp rdf:type owl:ObjectProperty ;
            rdfs:comment "Links an adaptation to the person who adapted the work."@en .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:ObjectProperty ;
                rdfs:comment "Links to the author of a work."@en .


###  http://purl.org/dc/terms/isVersionOf
dcterms:isVersionOf rdf:type owl:ObjectProperty ;
                    rdfs:comment "Links an adaptation to the work it adapts."@en .


###  http://purl.org/dc/terms/language
dcterms:language rdf:type owl:ObjectProperty ;
                 rdfs:comment """Language of a work, from the TEI attribute @to, it is mapped in the scripts
for completeness. The current TEI encodes no language relation."""@en .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:ObjectProperty ;
                  rdfs:comment "Links a work to the organisation that published it."@en .


###  http://purl.org/dc/terms/relation
dcterms:relation rdf:type owl:ObjectProperty ;
                 rdfs:comment "Generic link between the ATU 1645 tale type and Rumi, author of its earliest known version."@en .


###  http://purl.org/dc/terms/rightsHolder
dcterms:rightsHolder rdf:type owl:ObjectProperty ;
                     rdfs:comment "Links the novel to the companies that held its film rights."@en .


###  http://purl.org/dc/terms/subject
dcterms:subject rdf:type owl:ObjectProperty ;
                rdfs:comment "Links the novel to its main themes."@en .


###  http://purl.org/vocab/relationship/engagedTo
rel:engagedTo rdf:type owl:ObjectProperty ;
              rdfs:comment "Links Santiago and Fatima, who promise to marry."@en .


###  http://purl.org/vocab/relationship/mentorOf
rel:mentorOf rdf:type owl:ObjectProperty ;
             rdfs:comment "Links a character to the character he guides."@en .


###  https://schema.org/about
schema:about rdf:type owl:ObjectProperty ;
             rdfs:comment "Links an event or a text to the work it concerns."@en .


###  https://schema.org/character
schema:character rdf:type owl:ObjectProperty ;
                 rdfs:comment "Links the novel to its characters."@en .


###  https://schema.org/contentLocation
schema:contentLocation rdf:type owl:ObjectProperty ;
                       rdfs:comment "Links the novel to the places where the story is set."@en .


###  https://schema.org/founder
schema:founder rdf:type owl:ObjectProperty ;
               rdfs:comment "Links a company to its founder."@en .


###  https://schema.org/homeLocation
schema:homeLocation rdf:type owl:ObjectProperty ;
                    rdfs:comment "Links a character to his home place."@en .


###  https://schema.org/illustrator
schema:illustrator rdf:type owl:ObjectProperty ;
                   rdfs:comment "Links a work to its illustrator."@en .


###  https://schema.org/isBasedOn
schema:isBasedOn rdf:type owl:ObjectProperty ;
                 rdfs:comment "Links a work to a source of inspiration that is not a direct adaptation."@en .


###  https://schema.org/location
schema:location rdf:type owl:ObjectProperty ;
                rdfs:comment "Links an event to the place where it happened."@en .


###  https://schema.org/parentOrganization
schema:parentOrganization rdf:type owl:ObjectProperty ;
                          rdfs:comment "Links an imprint to its parent company."@en .


###  https://schema.org/performer
schema:performer rdf:type owl:ObjectProperty ;
                 rdfs:comment "Links an event to the band that performed."@en .


###  https://schema.org/producer
schema:producer rdf:type owl:ObjectProperty ;
                rdfs:comment "Links a work to the person or organisation that produced it."@en .


#################################################################
#    Data properties
#################################################################

###  http://schema.org/endDate
<http://schema.org/endDate> rdf:type owl:DatatypeProperty ;
                            rdfs:comment "End date of an event, from the TEI attribute @to, it is mapped in the script for completeness; no event in the current TEI has an end date."@en .


###  http://schema.org/genre
<http://schema.org/genre> rdf:type owl:DatatypeProperty ;
                          rdfs:comment "Genre of medium of each item (novel, manga, film etc.), used to distinguish works that share the class CreativeWork. It is used in the items dataset."@en .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:DatatypeProperty ;
               rdfs:comment "Preferred label of a concept."@en .


###  https://schema.org/birthDate
schema:birthDate rdf:type owl:DatatypeProperty ;
                 rdfs:comment "Year or date of birth of a person."@en .


###  https://schema.org/datePublished
schema:datePublished rdf:type owl:DatatypeProperty ;
                     rdfs:comment "Year of publication or release of a work."@en .


###  https://schema.org/deathDate
schema:deathDate rdf:type owl:DatatypeProperty ;
                 rdfs:comment "Year of death of a person."@en .


###  https://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:comment "Name or title of an entity"@en .


###  https://schema.org/startDate
schema:startDate rdf:type owl:DatatypeProperty ;
                 rdfs:comment "Year in which an event took place."@en .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/FictionalCharacter
dbo:FictionalCharacter rdf:type owl:Class ;
                       rdfs:comment "Characters of the novel, kept distinct from real persons."@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:comment "Key themes of the novel (Personal Legend, Soul of the World)."@en .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class ;
                    rdfs:comment "Works inside the graph: The novel, its adaptations and derivative works, its narrative sources and the cited texts."@en .


###  https://schema.org/Event
schema:Event rdf:type owl:Class ;
             rdfs:comment "Dated events in the history of the novel: Publications, releases, productions and acquisitions of rights."@en .


###  https://schema.org/Organization
schema:Organization rdf:type owl:Class ;
                    rdfs:comment "Publishers, imprints, production companies and groups involved in the novel's publication and adaptations."@en .


###  https://schema.org/Person
schema:Person rdf:type owl:Class ;
              rdfs:comment "Real people: The author, adapters, illustrators, composers, producers and all the figures connected to the novel."@en .


###  https://schema.org/Place
schema:Place rdf:type owl:Class ;
             rdfs:comment "Places where the story is set and where related events took place."@en .


