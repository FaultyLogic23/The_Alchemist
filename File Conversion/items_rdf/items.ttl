    schema:isBasedOn alch:theAlchemist ;
    schema:name "Kochavva Paulo Ayyappa Coelho"@en .

alch:mangaAdaptation a schema:CreativeWork ;
    dcterms:isVersionOf alch:theAlchemist ;
    dcterms:publisher alch:kadokawamasterpieceComics ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:genre "manga"@en ;
    schema:illustrator alch:tamakiNakamura ;
    schema:name "The Alchemist (manga adaptation)"@en .

alch:onethousandAndonenights a schema:CreativeWork ;
