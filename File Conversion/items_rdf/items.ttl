@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

alch:comicJubran a schema:CreativeWork ;
    dcterms:creator alch:ajubran ;
    dcterms:isVersionOf alch:theAlchemist ;
    schema:datePublished "1994"^^xsd:gYear ;
    schema:genre "comic"@en ;
    schema:name "The Alchemist (comic book adaptation)"@en .

alch:cornishStage a schema:CreativeWork ;
    dcterms:isVersionOf alch:theAlchemist ;
    schema:genre "stage production"@en ;
    schema:name "The Alchemist (Cornish Collective Stage Production)"@en ;
    schema:producer alch:cornishCollective .

alch:filmAdaptation a schema:CreativeWork ;
    dcterms:creator alch:jackThorne ;
    dcterms:isVersionOf alch:theAlchemist ;
    schema:genre "film"@en ;
    schema:name "The Alchemist (film adaptation)"@en ;
    schema:producer alch:tristarPictures .

alch:illustratedEdition a schema:CreativeWork ;
    dcterms:isVersionOf alch:theAlchemist ;
    dcterms:publisher alch:harperOne ;
    schema:genre "illustrated edition"@en ;
    schema:illustrator alch:moebius ;
    schema:name "The Alchemist (illustrated edition)"@en .

alch:indianStage a schema:CreativeWork ;
    marcrel:adp alch:deepaGahlot ;
    dcterms:isVersionOf alch:theAlchemist ;
    schema:datePublished "2009"^^xsd:gYear ;
    schema:genre "stage production"@en ;
    schema:name "The Alchemist (Indian stage version)"@en ;
    schema:producer alch:ashvingidwani .

alch:kochavvaPaulocoelho a schema:CreativeWork ;
