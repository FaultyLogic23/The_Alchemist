@prefix alch: <https://w3id.org/alchemist/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

alch:illustratedEdition a schema:CreativeWork ;
    dcterms:isVersionOf alch:theAlchemist ;
    dcterms:publisher alch:harperOne ;
    schema:genre "illustrated edition"@en ;
    schema:illustrator alch:moebius ;
    schema:name "The Alchemist (illustrated edition)"@en .

alch:harperOne a schema:Organization ;
    rdfs:seeAlso wd:Q28228463 ;
    schema:name "HarperOne"@en .

alch:moebius a schema:Person ;
    rdfs:seeAlso wd:Q309240 ;
    schema:name "Mœbius"@en .

