@prefix alch: <https://w3id.org/alchemist/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix marcrel: <http://id.loc.gov/vocabulary/relators/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

alch:theAlchemistgraphic a schema:CreativeWork ;
    marcrel:adp alch:derekr ;
    dcterms:isVersionOf alch:theAlchemist ;
    schema:datePublished "2010"^^xsd:gYear ;
    schema:genre "graphic novel"@en ;
    schema:illustrator alch:danielSampere ;
    schema:name "The Alchemist: A Graphic Novel"@en .

alch:danielSampere a schema:Person ;
    rdfs:seeAlso wd:Q112521933 ;
    schema:name "Daniel Sampere"@en .

alch:derekr a schema:Person ;
    schema:name "Derek Ruiz"@en .

