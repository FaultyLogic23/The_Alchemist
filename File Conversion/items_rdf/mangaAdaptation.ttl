@prefix alch: <https://w3id.org/alchemist/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

alch:mangaAdaptation a schema:CreativeWork ;
    dcterms:isVersionOf alch:theAlchemist ;
    dcterms:publisher alch:kadokawamasterpieceComics ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:genre "manga"@en ;
    schema:illustrator alch:tamakiNakamura ;
    schema:name "The Alchemist (manga adaptation)"@en .

alch:kadokawamasterpieceComics a schema:Organization ;
    rdfs:seeAlso wd:Q115754348 ;
    schema:name "Kadokawa Masterpiece Comics"@en .

alch:tamakiNakamura a schema:Person ;
    schema:name "Tamaki Nakamura"@en .

