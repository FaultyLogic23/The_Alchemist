@prefix alch: <https://w3id.org/alchemist/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

alch:wikipediaArticle a schema:CreativeWork ;
    dcterms:publisher alch:wikipedia ;
    schema:about alch:theAlchemist ;
    schema:genre "encyclopedia article"@en ;
    schema:name "The Alchemist (novel) – Wikipedia article"@en .

alch:wikipedia a schema:Organization ;
    rdfs:seeAlso wd:Q52 ;
    schema:name "Wikipedia"@en .

